# Optional Cognito overrides (normally come from amplify_outputs.json).
# VITE_AWS_REGION=
# VITE_USER_POOL_ID=
# VITE_USER_POOL_CLIENT_ID=
# VITE_IDENTITY_POOL_ID=

# Prefer amplify_outputs.json for Function URLs (recommended for local UI work).
# Run: npm run sync:outputs
# Only set VITE_*_URL below if you intentionally override a single endpoint.
# To force all VITE_* URL overrides: VITE_PREFER_ENV_ENDPOINTS=true

